{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [],
    "deny": [
      "mcp__claude-in-chrome"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "skillOverrides": {
    "felipego-projects": "off",
    "claude-in-chrome": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; p=os.path.expanduser('~/.dotfiles-hooks/guard.py'); os.path.exists(p) and runpy.run_path(p, run_name='__main__')\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cowork-plugin-management@inline": false,
    "insecure-defaults@trailofbits": true,
    "static-analysis@trailofbits": true,
    "supply-chain-risk-auditor@trailofbits": true,
    "context-meter@better-claude": true,
    "after@better-claude": false,
    "think-hard@better-claude": false,
    "token-meter@better-claude": false,
    "sub-meter@better-claude": false,
    "image-preview@better-claude": false,
    "quick-peek@better-claude": false
  },
  "extraKnownMarketplaces": {
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    },
    "better-claude": {
      "source": {
        "source": "github",
        "repo": "midudev/better-claude"
      }
    }
  },
  "outputStyle": "Concise",
  "language": "Español",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "autoCompactWindow": 800000
    }
  },
  "advisorModel": "sonnet",
  "autoDreamEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1"
  }
}
