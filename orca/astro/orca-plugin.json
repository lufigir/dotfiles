{
  "manifestVersion": 2,
  "id": "astro",
  "name": "Astro",
  "version": "1.2.0",
  "description": "Casi negro con acento lila suave para la app y el terminal de Orca.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "data",
  "contributes": {
    "themes": [
      {
        "id": "astro-dark",
        "title": "Astro",
        "path": "themes/dark.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "astro-terminal",
        "title": "Astro",
        "path": "themes/terminal.json"
      }
    ]
  }
}