{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#4B3B5C",
          "style": "plain",
          "template": "╭ ",
          "type": "text"
        },
        {
          "foreground": "#B084F5",
          "options": {
            "style": "folder"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "#E0A6E8",
          "options": {
            "branch_icon": " ",
            "fetch_status": true
          },
          "style": "plain",
          "template": "{{ .HEAD }} {{ if .Staging.Changed }}<#7FDBAA> {{ .Staging.String }}</> {{ end }}{{ if .Working.Changed }}<#F5D76E> {{ .Working.String }}</> {{ end }}",
          "type": "git"
        },
        {
          "foreground": "#B084F5",
          "style": "plain",
          "template": "<#7A5C9E>is</>  v{{ .Version }} ",
          "type": "project"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "foreground": "#F5B8E8",
          "style": "plain",
          "template": "✗ {{ .Code }} ",
          "type": "status",
          "properties": {
            "always_enabled": false
          }
        },
        {
          "foreground": "#7A5C9E",
          "style": "plain",
          "template": "{{ .FormattedMs }} ",
          "type": "executiontime",
          "properties": {
            "threshold": 2000
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#4B3B5C",
          "style": "plain",
          "template": "╰ ",
          "type": "text"
        },
        {
          "foreground": "#C792EA",
          "style": "plain",
          "template": "❯ ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
